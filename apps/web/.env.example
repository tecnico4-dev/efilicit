# Copy to apps/web/.env.local (never commit .env.local)
# Fill from: supabase status -o env  (use local ANON_KEY / API_URL)

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mis licitaciones (offer_*): solo local hasta MVP. Remoto/Vercel: omitir o 0.
# Reiniciar `pnpm dev` tras cambiar.
NEXT_PUBLIC_MIS_LICITACIONES_ENABLED=1

# Local Auth seed (Fase 0 / Semana 5): alice@example.com / bob@example.com — password123
